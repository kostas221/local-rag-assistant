# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε πραγματικές τιμές.
# Το .env είναι gitignored — ΠΟΤΕ μην κάνεις commit πραγματικά κλειδιά.

# Gemini API key (generation + translation + LLM-judge): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Μοντέλο Gemini — αλλάζει χωρίς rebuild. Default: gemini-3.8-flash (μετρημένο 18-19/11/2026).
# Το gemini-2.5-flash δεν δίνεται πια σε κλειδιά και από 1/12/2026 ανακατευθύνεται στο 3.5-flash-lite.
# Default model: gemini-3.8-flash. gemini-2.5-flash is no longer offered and redirects from 2026-12-01.
# GEMINI_MODEL=gemini-3.8-flash

# Κωδικός της Postgres (το docker-compose φτιάχνει μόνο του το DATABASE_URL)
POSTGRES_PASSWORD=choose-a-strong-password

# JWT signing key — φτιάξε με: openssl rand -hex 32
SECRET_KEY=paste-64-hex-chars-here

# (Deploy) Επιτρεπόμενα CORS origins (comma-separated). Χρειάζεται ΜΟΝΟ αν το UI σερβιριστεί από άλλο domain:
# με το nginx του web/ το /api είναι στο ίδιο origin.
# π.χ. ALLOWED_ORIGINS=https://rag.sxoli.gr
