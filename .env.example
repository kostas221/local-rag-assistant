# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε πραγματικές τιμές.
# Το .env είναι gitignored — ΠΟΤΕ μην κάνεις commit πραγματικά κλειδιά.

# Gemini API key (generation + translation + LLM-judge): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Μοντέλο Gemini — αλλάζει χωρίς rebuild. Default: gemini-2.5-flash (σε αυτό μετρήθηκαν όλα).
# ΝΕΟ ΚΛΕΙΔΙ: η Google δεν δίνει πια το 2.5-flash σε νέα κλειδιά -> βγάλε το # από την επόμενη γραμμή.
# New API key: gemini-2.5-flash is no longer offered to new keys -> uncomment the next line.
# GEMINI_MODEL=gemini-3.8-flash

# Κωδικός της Postgres (το docker-compose φτιάχνει μόνο του το DATABASE_URL)
POSTGRES_PASSWORD=choose-a-strong-password

# JWT signing key — φτιάξε με: openssl rand -hex 32
SECRET_KEY=paste-64-hex-chars-here

# (Deploy) Επιτρεπόμενα CORS origins (comma-separated). Default: τοπικό Streamlit.
# π.χ. ALLOWED_ORIGINS=https://rag.sxoli.gr
# ALLOWED_ORIGINS=http://localhost:8501
